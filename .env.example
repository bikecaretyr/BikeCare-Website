# ═══════════════════════════════════════════
# BALAJI MOTORS BMS — Environment Variables
# Copy this to .env and fill in your values
# NEVER commit .env to version control
# ═══════════════════════════════════════════

# Server
NODE_ENV=production
PORT=5000

# MongoDB
# Mongo Root
MONGO_ROOT_USER=rootadmin
MONGO_ROOT_PASS=change_this_root_password_in_production

# App DB User
MONGO_APP_USER=userapp
MONGO_APP_PASS=change_this_app_password_in_production

# Database
MONGO_DB=balaji_motors_bms
MONGO_URI=mongodb://userapp:change_this_app_password_in_production@mongo:27017/balaji_motors_bms?authSource=balaji_motors_bms

# JWT
JWT_SECRET=change_this_secret_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_this_refresh_secret_in_production
JWT_REFRESH_EXPIRES_IN=7d

# ─── SUPERADMIN — Developer Only ───────────
# This is YOU. Never store this in DB.
# Login at /superadmin with these credentials.
SUPERADMIN_USERNAME=change_this_superadmin_username_in_production
SUPERADMIN_PASSWORD=change_this_superadmin_password_in_production
SUPERADMIN_SECRET_KEY=change_this_superadmin_secret_key_in_production

# ─── Admin Account (auto-created on first run) ─
ADMIN_NAME=Balaji Motors Admin
ADMIN_EMAIL=change_this_admin_email_in_production
ADMIN_PASSWORD=change_this_admin_password_in_production

# ─── Email (Nodemailer + Gmail SMTP) ────────
GMAIL_USER=change_this_gmail_user_in_production
GMAIL_APP_PASSWORD=change_this_gmail_app_password_in_production
EMAIL_FROM=change_this_email_from_in_production

# ─── Security ───────────────────────────────
BCRYPT_SALT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
LOGIN_RATE_LIMIT_MAX=100
CSRF_SECRET=change_this_csrf_secret_in_production

# ─── CORS ───────────────────────────────────
# Your production domain once purchased
CLIENT_URL=http://localhost:5000

# ─── Cookie ─────────────────────────────────
COOKIE_SECRET=change_this_cookie_secret_in_production
